          fb.innerHTML = `✅ Верно! ${state.current.syll} — финаль <b>${state.current.correct}</b>.
            ${state.current.hint ? `<div class="hint">${state.current.hint}</div>` : ''}`;
          fb.className = 'feedback correct';
          playAudio(state.current.char);
          setTimeout(next, 2500);
        } else {
          fb.innerHTML = `❌ Ошибка. ${state.current.syll} — финаль <b>${state.current.correct}</b>, а не ${chosen}.
            ${state.current.hint ? `<div class="hint">${state.current.hint}</div>` : ''}`;
          fb.className = 'feedback wrong';
          setTimeout(next, 3000);
        }
      });
    });
  }
  next();
}

/* ==================== 8. ИГРА СОКРАЩЕНИЯ ==================== */
function renderAbbrev(main) {
  const bag = createBag(ABBREV_DATA);
  const state = { score: 0, total: 0, current: null, locked: false };

  main.innerHTML = `
    <div class="panel">
      <h2>Сокращенные финали</h2>
      <p class="intro">В пиньине iou, uei и uen сокращаются. Какая полная финаль скрыта в этом слоге?</p>
      <div class="score">Счёт: <span id="score">0</span> / <span id="total">0</span></div>
      <div class="syll-box">
        <div id="abbr-pinyin" class="syll-pinyin">?</div>
        <div id="abbr-char" class="syll-char"></div>
      </div>
      <div id="options" class="options-grid three"></div>
      <div id="feedback" class="feedback"></div>
    </div>
  `;

  function next() {
    state.locked = false;
    state.current = bag();
    
    main.querySelector('#abbr-pinyin').textContent = state.current.syll;
    main.querySelector('#abbr-char').textContent = state.current.char;
    
    const opts = main.querySelector('#options');
    opts.innerHTML = state.current.options.map(o => `<button class="option-btn big" data-init="${o}">${o}</button>`).join('');
    
    const fb = main.querySelector('#feedback');
    fb.textContent = ''; fb.className = 'feedback';

    opts.querySelectorAll('.option-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        if (state.locked) return; state.locked = true;
        const chosen = btn.dataset.init;
        state.total++; main.querySelector('#total').textContent = state.total;
        
        if (chosen === state.current.full) {
          state.score++; main.querySelector('#score').textContent = state.score;
          fb.innerHTML = `✅ Верно! ${state.current.syll} = <b>${state.current.full}</b>.`;
          fb.className = 'feedback correct';
          playAudio(state.current.char);
          setTimeout(next, 1500);
        } else {
          fb.innerHTML = `❌ Ошибка. ${state.current.syll} — это сокращение от <b>${state.current.full}</b>.`;
          fb.className = 'feedback wrong';
          setTimeout(next, 2500);
        }
      });
    });
  }
  next();
}

render();
</script>
