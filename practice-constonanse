function renderAudio(main) {
  const allSylls = Object.values(INITIALS).map(d => ({ 
    init: d.ex.split(' ')[0].replace(/[āáǎàēéěèīíǐìōóǒòūúǔùǖǘǚǜ]/g, ''), 
    char: d.char, 
    syll: d.ex.split(' ')[0] 
  }));
  const bag = createBag(allSylls);
  const state = { score: 0, total: 0, current: null, locked: false };

  main.innerHTML = `
    <div class="panel">
      <h2>Аудио-диктант</h2>
      <p class="intro">Послушайте звук и выберите правильную инициаль.</p>
      <div class="score">Счёт: <span id="score">0</span> / <span id="total">0</span></div>
      <div class="target-box">
        <div class="target-label">Послушайте звук</div>
        <button id="play-audio" class="speak-btn" style="font-size:24px; padding: 15px 30px; margin-top: 10px;">🔊 Воспроизвести</button>
      </div>
      <div id="options" class="options-grid"></div>
      <div id="feedback" class="feedback"></div>
    </div>
  `;

  function next() {
    state.locked = false;
    state.current = bag();
    setTimeout(() => playAudio(state.current.char), 100);
    main.querySelector('#play-audio').onclick = () => playAudio(state.current.char);

    const correctInit = state.current.init;
    const group = INITIALS[correctInit].group;
    const sameGroup = GROUPS[group].letters.filter(l => l !== correctInit);
    
    let pool = [...sameGroup];
    const others = Object.keys(INITIALS).filter(l => l !== correctInit && !sameGroup.includes(l));
    while (pool.length < 3) {
      const cand = others[Math.floor(Math.random() * others.length)];
      if (!pool.includes(cand)) pool.push(cand);
    }
    const options = shuffle([correctInit, ...pool.slice(0, 3)]);

    const opts = main.querySelector('#options');
    opts.innerHTML = options.map(o => `<button class="option-btn" data-init="${o}">${o}</button>`).join('');
    
    opts.querySelectorAll('.option-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        if (state.locked) return; state.locked = true;
        const chosen = btn.dataset.init;
        state.total++; main.querySelector('#total').textContent = state.total;
        const fb = main.querySelector('#feedback');
        if (chosen === correctInit) {
          state.score++; main.querySelector('#score').textContent = state.score;
          fb.textContent = `✅ Верно! Инициаль «${correctInit}»`;
          fb.className = 'feedback correct';
          setTimeout(next, 1200);
        } else {
          fb.textContent = `❌ Это инициаль «${correctInit}», а не «${chosen}»`;
          fb.className = 'feedback wrong';
          setTimeout(next, 1800);
        }
      });
    });
    const fb = main.querySelector('#feedback');
    fb.textContent = ''; fb.className = 'feedback';
  }
  next();
}

