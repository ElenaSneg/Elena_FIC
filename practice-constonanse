/* ==================== ОЗВУЧКА (ИЗ ИГРЫ С ПАНДОЙ) ==================== */
var audioPlayer = document.getElementById('player');
var lastPlayed = 0;

function playAudio(zh) {
  var now = Date.now();
  if (now - lastPlayed < 250) return; // Защита от двойного клика
  lastPlayed = now;
  try {
    audioPlayer.pause();
    // 1. Пытаемся загрузить с Baidu (лучшее качество)
    audioPlayer.src = 'https://fanyi.baidu.com/gettts?lan=zh&text=' +
      encodeURIComponent(zh) + '&spd=2&source=web';
    audioPlayer.load();
    var pr = audioPlayer.play();
    
    if (pr && pr.catch) {
      pr.catch(function() {
        // 2. Если Baidu недоступен, пробуем Google Translate
        audioPlayer.src = 'https://translate.google.com/translate_tts?ie=UTF-8&q=' +
          encodeURIComponent(zh) + '&tl=zh-CN&client=tw-ob&ttsspeed=0.5';
        audioPlayer.load();
        audioPlayer.play().catch(function() {
          // 3. Если и это не сработало, используем встроенный синтезатор
          if (window.speechSynthesis) {
            window.speechSynthesis.cancel();
            var u = new SpeechSynthesisUtterance(zh);
            u.lang = 'zh-CN';
            u.rate = 0.7;
            window.speechSynthesis.speak(u);
          }
        });
      });
    }
  } catch (e) { console.log(e); }
}

/* ==================== ВСПОМОГАТЕЛЬНЫЕ ==================== */
function shuffle(array) {
  let currentIndex = array.length, randomIndex;
  while (currentIndex !== 0) {
    randomIndex = Math.floor(Math.random() * currentIndex);
    currentIndex--;
    [array[currentIndex], array[randomIndex]] = [array[randomIndex], array[currentIndex]];
  }
  return array;
}

function createBag(items) {
  let pool = shuffle([...items]);
  return function getNext() {
    if (pool.length === 0) pool = shuffle([...items]);
    return pool.pop();
  };
}

